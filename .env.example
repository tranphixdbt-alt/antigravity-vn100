# Sao chép file này thành .env nếu muốn bật API live/AI.
# Không commit .env vì file đó chứa key thật.

# Dữ liệu portable mặc định đọc từ vn100_full.db trong thư mục dự án.
# Nếu chạy bằng Chay_Dinh_Gia_VN100.command, launcher sẽ tự set 2 biến này.
DATABASE_URL_READONLY=
DATABASE_URL_WRITE=

# vnstock: chỉ cần khi muốn cập nhật dữ liệu mới/live.
VNSTOCK_API_KEY=

# DeepSeek: chỉ dùng khi bấm nút sinh báo cáo AI.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google/Discord: chỉ cần nếu dùng xuất Google Sheets/Drive hoặc cảnh báo Discord.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_MASTER_ID=
GOOGLE_DRIVE_FOLDER_ID=
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
# Bot chỉ nhận lệnh trong 1 kênh; để trống DISCORD_OWNER_ID = mọi thành viên kênh dùng được (Developer Mode → Copy ID).
DISCORD_OWNER_ID=
DISCORD_CHANNEL_ID=
RECOMPUTE_WEBHOOK_TOKEN=

# Tham số định giá có thể override trong môi trường.
ERP_VN=

# Mặc định dùng giá đã lưu trong DB portable để ai tải về cũng chạy được.
# Đổi thành 1 nếu máy có key/quyền API và muốn lấy giá live.
ENABLE_LIVE_PRICE=0

# n8n (scripts/activate_n8n.py, scripts/import_n8n.py)
N8N_BASE_URL=
N8N_API_KEY=

# Web hợp nhất btinvest.vn (lát 5a): tài khoản được duyệt. Tệp dữ liệu người dùng tách khỏi DB định giá.
WEB_USER_DB_URL=sqlite:///web_user.db
# coin = hỏi dịch vụ đăng nhập coin (mặc định, dùng trên VPS); dev = một người dùng thử, chỉ nhận yêu cầu từ chính máy này.
WEB_AUTH_MODE=coin
# Địa chỉ /api/v1/auth/me của dịch vụ coin (trên VPS là địa chỉ trong mạng Docker).
WEB_AUTH_ME_URL=
# Email hoặc tên đăng nhập coin của Quản trị đầu tiên, cách nhau bằng dấu phẩy.
WEB_ADMIN_EMAILS=
# Chỉ dùng khi WEB_AUTH_MODE=dev: email của người dùng thử.
WEB_DEV_USER=
# Địa chỉ dịch vụ chứng quyền khi không chạy cùng máy (VPS: http://chungquyen:8000). Trống = web.cw_base_url trong config.
WEB_CW_BASE_URL=
