# === SAO CHÉP FILE NÀY THÀNH .env VÀ ĐIỀN GIÁ TRỊ THẬT. KHÔNG COMMIT .env ===
# vnstock
VNSTOCK_API_KEY=
# PostgreSQL
DATABASE_URL_READONLY=postgresql://readonly_user:CHANGEME@localhost:5432/vn100
DATABASE_URL_WRITE=postgresql://write_user:CHANGEME@localhost:5432/vn100
# Google (service account JSON đặt ngoài repo, chỉ trỏ đường dẫn)
GOOGLE_SERVICE_ACCOUNT_JSON=/secrets/gcp-service-account.json
GOOGLE_SHEET_MASTER_ID=
GOOGLE_DRIVE_FOLDER_ID=
# Discord
DISCORD_WEBHOOK_URL=
# Webhook auth (cho recompute từ Sheet)
RECOMPUTE_WEBHOOK_TOKEN=
# Tham số định giá (mặc định, có thể override trong config)
ERP_VN=
