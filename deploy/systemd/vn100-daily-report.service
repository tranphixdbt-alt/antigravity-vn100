[Unit]
Description=VN100 - báo cáo sáng lên Discord (scripts/daily_report.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/python scripts/daily_report.py
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:__APP_DIR__/logs/daily_report.log
StandardError=append:__APP_DIR__/logs/daily_report.log
